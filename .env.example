# =============================================================================
# UASI v5 Enterprise Production — variables de entorno
# Copie este archivo a `.env` y ajuste los valores:   cp .env.example .env
# Genere secretos seguros con:                        ./scripts/generar_secretos.sh
# NUNCA suba `.env` al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno y rutas
# -----------------------------------------------------------------------------
# development | production. En "production" se desactiva /api/v5/token.
UASI_ENV=development
# Directorio raíz de datos (modelos/, ledger/, ots_proofs/). Debe ser persistente
# y compartido por todos los workers. En Docker se monta como volumen en /data.
PATH_WORKSPACE=./uasi_workspace
# Nivel de log (DEBUG, INFO, WARNING, ERROR). Los logs salen en JSON por stdout.
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Autenticación JWT (OBLIGATORIA)
# -----------------------------------------------------------------------------
# Clave HMAC para firmar/validar tokens. Mínimo 32 caracteres.
# Si está vacía, los endpoints protegidos responden 503 (fail-closed).
SECRET_JWT_KEY=cambie-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# Algoritmo de firma del JWT.
JWT_ALGORITHM=HS256
# Valor obligatorio del claim "iss" en los tokens.
JWT_ISSUER=uasi-v5
# Caducidad por defecto (minutos) de los tokens emitidos por el sistema.
JWT_EXP_MINUTES=60

# -----------------------------------------------------------------------------
# Integridad de modelos
# -----------------------------------------------------------------------------
# Si se define, los checksums de modelos son HMAC-SHA256 (recomendado):
# un atacante con escritura en disco no puede recalcularlos sin esta clave.
# Si se cambia, los modelos existentes dejarán de validar (reentrenar).
UASI_MODEL_HMAC_KEY=cambie-esto-por-otro-secreto-aleatorio-distinto

# -----------------------------------------------------------------------------
# Protección de la API
# -----------------------------------------------------------------------------
# Peticiones por minuto y por IP (slowapi).
RATE_LIMIT_PER_MINUTE=30
# Backend del contador. memory:// = por worker. redis://host:6379 = global.
# En docker-compose se usa redis://redis:6379 automáticamente.
RATE_LIMIT_STORAGE_URI=memory://
# Tamaño máximo del cuerpo HTTP en bytes (10 MB). Excederlo → 413.
MAX_PAYLOAD_BYTES=10485760
# Máximo de muestras (filas) por petición.
UASI_MAX_MUESTRAS=50000
# Máximo de características (columnas) por muestra.
UASI_MAX_FEATURES=512

# -----------------------------------------------------------------------------
# Metacognición (enrutamiento por entropía de Shannon)
# -----------------------------------------------------------------------------
# Entropía de clases normalizada por debajo de este umbral ⇒ desbalance ⇒ Gradient Boosting.
UASI_UMBRAL_ENTROPIA_DESBALANCE=0.85
# Entropía media de características por encima de este umbral (n ≥ 100) ⇒ Gradient Boosting.
UASI_UMBRAL_ENTROPIA_FEATURES=0.90

# -----------------------------------------------------------------------------
# Bitcoin / OpenTimestamps
# -----------------------------------------------------------------------------
# mainnet | testnet. Los calendarios públicos OTS solo anclan en MAINNET;
# para testnet hace falta un calendario propio (otsd) en OTS_CALENDARS.
BITCOIN_NETWORK=mainnet
# Calendarios OTS separados por comas.
OTS_CALENDARS=https://a.pool.opentimestamps.org,https://b.pool.opentimestamps.org,https://a.pool.eternitywall.com
# Mínimo de calendarios que deben aceptar el compromiso para considerar el anclaje válido.
OTS_MIN_CALENDARS=1
# Timeout de red (segundos) para calendarios y explorador.
OTS_TIMEOUT_SECONDS=10
# API Esplora para contrastar la merkle root del bloque (por defecto según la red).
ESPLORA_API_URL=https://blockstream.info/api

# -----------------------------------------------------------------------------
# Servidor (solo al ejecutar main.py directamente / Makefile)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=1
# Workers de gunicorn (make run-prod / Docker).
GUNICORN_WORKERS=4

# -----------------------------------------------------------------------------
# Scripts (scripts/*.sh y make anchor-btc)
# -----------------------------------------------------------------------------
# URL base de la API que usan los scripts.
UASI_API_URL=http://localhost:8000
# Token Bearer de servicio para los scripts (en producción, emitido por su IdP).
UASI_TOKEN=

# -----------------------------------------------------------------------------
# Tests
# -----------------------------------------------------------------------------
# 1 = ejecuta el test de anclaje real contra los calendarios OpenTimestamps.
UASI_TEST_OTS_RED=0
